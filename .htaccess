Options -Indexes
DirectoryIndex index.php
AddType image/avif .avif
AddType image/webp .webp

<IfModule php_module>
    php_flag expose_php Off
    php_flag session.cookie_httponly On
    php_value session.cookie_samesite Lax
</IfModule>

RewriteEngine On
RewriteRule (^|/)\. - [F,L]
RewriteRule ^config(?:\.[a-z]+)?\.php$ - [F,L,NC]

# Internal code and deployment artifacts are never public endpoints.
RewriteRule ^(?:vendor|scripts|database|tmp|includes|output|dist|backups)(?:/|$) - [F,L,NC]
RewriteRule ^admin/includes(?:/|$) - [F,L,NC]

RewriteCond %{THE_REQUEST} \s/+((?:[^?\s/]+/)*)project\.php\?id=([0-9]+) [NC]
RewriteRule ^project\.php$ /%1projects/%2? [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+((?:[^?\s/]+/)*)article\.php\?id=([0-9]+) [NC]
RewriteRule ^article\.php$ /%1articles/%2? [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+((?:[^?\s/]+/)*)photo\.php\?id=([0-9]+) [NC]
RewriteRule ^photo\.php$ /%1photos/%2? [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+((?:[^?\s/]+/)*)video\.php\?id=([0-9]+) [NC]
RewriteRule ^video\.php$ /%1videos/%2? [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+((?:[^?\s/]+/)*)index\.php[\s?] [NC]
RewriteRule ^index\.php$ /%1 [R=301,L]
RewriteCond %{THE_REQUEST} \s/+((?:[^?\s/]+/)*)(projects|articles|resume|media|contact|now|login)\.php[\s?] [NC]
RewriteRule ^(projects|articles|resume|media|contact|now|login)\.php$ /%1%2 [R=301,L]

RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]

RewriteRule ^projects/([0-9]+)/?$ project.php?id=$1 [L,QSA]
RewriteRule ^articles/([0-9]+)/?$ article.php?id=$1 [L,QSA]
RewriteRule ^photos/([0-9]+)/?$ photo.php?id=$1 [L,QSA]
RewriteRule ^videos/([0-9]+)/?$ video.php?id=$1 [L,QSA]

RewriteRule ^projects/?$ projects.php [L]
RewriteRule ^articles/?$ articles.php [L]
RewriteRule ^resume/download/?$ resume-download.php [L]
RewriteRule ^resume/?$ resume.php [L]
RewriteRule ^media/?$ media.php [L]
RewriteRule ^contact/?$ contact.php [L]
RewriteRule ^now/?$ now.php [L]
RewriteRule ^login/?$ login.php [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . 404.php [L]

<FilesMatch "\.(sql|md|ini|log|bak|ps1|sh)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(composer\.(json|lock)|package(?:-lock)?\.json)$">
    Require all denied
</FilesMatch>

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<FilesMatch ".*(backup|old|copy).*\.php$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|webp|jpg|jpeg|png|svg|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
