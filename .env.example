# This is documentation only: .env files are NOT parsed.
# DB_HOST/DB_NAME/DB_USER/DB_PASSWORD aliases are also supported.
# Hosts without environment variables: copy config.example.php to config.local.php.
# Supply these through the production host or Apache environment.
# Do not rename this file to a publicly served credential file.
XUVERSE_DB_HOST=127.0.0.1
XUVERSE_DB_USER=xuverse_app
XUVERSE_DB_PASSWORD=replace-with-a-strong-unique-password
XUVERSE_DB_NAME=xuverse
XUVERSE_BASE_URL=https://portfolio.example.com
# Use / when the site is the domain root, or /xuverse for a subdirectory install.
XUVERSE_APP_PATH=/
XUVERSE_PRODUCTION=true

# The public inquiry form sends to this address when provided.
# It falls back to the contact email configured in the XuVerse dashboard.
XUVERSE_CONTACT_TO=portfolio@example.com
# Must be an address hosted by the sending domain, for example hello@portfolio.example.com.
XUVERSE_CONTACT_FROM=hello@portfolio.example.com
